#
# Builder image for the Linux AppImage - x86_64, and arm64 for the
# Raspberry Pi 4/5. One Dockerfile for both: the base image resolves per
# platform (build_image.sh passes --platform), the apt package list is
# identical on both architectures, and only the packaging-tool downloads
# differ, selected by the build arguments described below.
#
# Separate from Dockerfile.mingw on purpose. The Windows image wants a current
# Debian because MXE is happiest there; this one wants the OLDEST base we are
# willing to support, because an AppImage can run on any glibc newer than the
# one it was built against and none older. The base choice is therefore the
# compatibility floor of the Linux delivery, not an incidental detail.
#
# sigrok-util/cross-compile/appimage/README targets Ubuntu 16.04 and a
# hand-built AppImageKit. Both are obsolete: 16.04 is long EOL and its archive
# has moved. Planning doc 06 already requires a maintained packaging tool
# instead, so this uses Ubuntu 22.04 (glibc 2.35, supported into 2027) and a
# pinned appimagetool release verified by checksum.

# syntax=docker/dockerfile:1.7

# Pinned by digest once the first build has recorded one; see images/README.md.
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# Packaging-tool releases and their SHA-256s. All of them come from the
# artifact table in 02_Tools/upstream/upstreams.lock.toml and are passed by
# build_image.sh, URL included, so the lock is the single place a version or
# a file name lives. There is no default checksum: an unverified download
# must not be silently accepted into a release toolchain.
#
# A packer plus a deployer, because they do different jobs. appimagetool only
# packs an AppDir into a self-extracting archive - it does no dependency
# resolution at all. The deployer is what actually walks the Qt platform
# plugin tree (libqxcb.so and everything it loads at runtime, which plain
# ldd never sees) and bundles the native libraries plain ldd DOES see. Using
# appimagetool alone produces an AppImage that launches headless and fails
# the moment it needs a real display.
#
# Both architectures use the same deployer: linuxdeployqt's release 11
# ships an aarch64 asset alongside the x86_64 one, so build_image.sh just
# passes the right architecture's URL from the lock.
#
# The type-2 AppImage RUNTIME is baked too. appimagetool downloads it from
# the network at PACKAGING time unless --runtime-file is passed - an
# unpinned fetch that hid inside the "offline" build until external review
# caught it. The runtime is a pinned artifact like everything else here,
# and build_appimage.sh points appimagetool at the baked copy.
ARG APPIMAGETOOL_VERSION
ARG APPIMAGETOOL_URL
ARG APPIMAGETOOL_SHA256
ARG LINUXDEPLOYQT_VERSION
ARG LINUXDEPLOYQT_URL
ARG LINUXDEPLOYQT_SHA256
ARG APPIMAGE_RUNTIME_VERSION
ARG APPIMAGE_RUNTIME_URL
ARG APPIMAGE_RUNTIME_SHA256

ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive

# FUSE is normally unavailable inside a container, which is exactly the failure
# appimagetool is famous for. Extracting instead of mounting avoids needing a
# privileged container.
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Native build dependencies for the whole sigrok stack. Grouped by which
# component needs them so the list stays auditable as components change.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        autoconf automake autoconf-archive libtool pkg-config make cmake \
        g++ git wget ca-certificates patch file desktop-file-utils zsync \
        patchelf \
        libglib2.0-dev libglibmm-2.4-dev libzip-dev check doxygen \
        libusb-1.0-0-dev libftdi1-dev libhidapi-dev libieee1284-3-dev \
        python3-dev python3-numpy python3-gi python3-setuptools swig \
        qtbase5-dev qttools5-dev qttools5-dev-tools libqt5svg5-dev \
        libboost-filesystem-dev libboost-serialization-dev \
        libboost-system-dev libboost-test-dev; \
    rm -rf /var/lib/apt/lists/*

# Pinned, checksum-verified packaging tools. A mismatch fails the image
# build. APPIMAGE_EXTRACT_AND_RUN (set above) covers all of them - none of
# these tools can FUSE-mount itself inside a container either.
#
# The dd after each verification zeroes the type-2 AppImage magic (AI\x02
# at ELF offset 8, three e_ident padding bytes). Without that, qemu's
# binfmt_misc magic match rejects the file and an EMULATED arm64 container
# cannot exec the tool at all - "Exec format error", which is exactly how
# the first emulated build died. A native kernel never reads those bytes,
# so the zeroing is harmless where emulation is not involved. It runs
# after sha256sum -c on purpose: the digest pins the published bytes.
RUN set -eux; \
    test -n "${APPIMAGETOOL_URL}"; \
    test -n "${APPIMAGETOOL_SHA256}"; \
    wget -O /usr/local/bin/appimagetool "${APPIMAGETOOL_URL}"; \
    echo "${APPIMAGETOOL_SHA256}  /usr/local/bin/appimagetool" | sha256sum -c -; \
    printf '\0\0\0' | dd of=/usr/local/bin/appimagetool bs=1 seek=8 count=3 conv=notrunc; \
    chmod +x /usr/local/bin/appimagetool; \
    test -n "${LINUXDEPLOYQT_URL}"; \
    test -n "${LINUXDEPLOYQT_SHA256}"; \
    wget -O /usr/local/bin/linuxdeployqt "${LINUXDEPLOYQT_URL}"; \
    echo "${LINUXDEPLOYQT_SHA256}  /usr/local/bin/linuxdeployqt" | sha256sum -c -; \
    printf '\0\0\0' | dd of=/usr/local/bin/linuxdeployqt bs=1 seek=8 count=3 conv=notrunc; \
    chmod +x /usr/local/bin/linuxdeployqt; \
    test -n "${APPIMAGE_RUNTIME_URL}"; \
    test -n "${APPIMAGE_RUNTIME_SHA256}"; \
    mkdir -p /usr/local/lib/appimage; \
    wget -O /usr/local/lib/appimage/runtime "${APPIMAGE_RUNTIME_URL}"; \
    echo "${APPIMAGE_RUNTIME_SHA256}  /usr/local/lib/appimage/runtime" | sha256sum -c -

RUN set -eux; \
    groupadd -g "${USER_GID}" builder 2>/dev/null || true; \
    useradd -m -u "${USER_UID}" -g "${USER_GID}" -s /bin/bash builder \
        2>/dev/null || true; \
    mkdir -p /work /out /build; \
    chown -R "${USER_UID}:${USER_GID}" /work /out /build

ARG BUILDER_SPEC=unrecorded

LABEL org.opencontainers.image.title="sigrok Linux AppImage builder" \
      org.opencontainers.image.description="Ubuntu 22.04 toolchain for building libsigrok, libsigrokdecode, sigrok-cli and PulseView as a Linux AppImage (x86_64 or aarch64)" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      io.ddp.appimagetool.version="${APPIMAGETOOL_VERSION}" \
      io.ddp.linuxdeployqt.version="${LINUXDEPLOYQT_VERSION}" \
      io.ddp.appimage-runtime.version="${APPIMAGE_RUNTIME_VERSION}" \
      io.ddp.glibc.floor="2.35" \
      io.ddp.builder.spec="${BUILDER_SPEC}"

USER ${USER_UID}:${USER_GID}
WORKDIR /work
CMD ["/bin/bash"]
