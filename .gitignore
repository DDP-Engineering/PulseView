# OS / Explorer noise
.DS_Store
Thumbs.db
Desktop.ini

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build artifacts
build/
# ...but 02_Tools/build/ is source, not output: it holds the container
# definitions and build drivers. The bare `build/` rule above matches at any
# depth and would silently swallow them.
!02_Tools/build/
dist/
*.egg-info/
*.egg

# Editor / IDE state
.idea/
.vscode/
.history/

# Local tool state
.codex/local/

# Build/research workspace: upstream clones, build prefixes, raw captures
.work/

# Delivery: release candidates are build output.
# Verified releases under 07_Delivery/releases/ are tracked deliberately.
07_Delivery/staging/

# 07_Delivery/toolchain/ is NOT ignored. The saved builder images live there
# as manifests plus Git LFS parts (see .gitattributes), because they make a
# clone buildable without reaching the upstream package hosts. Their logs and
# scratch are still output, though.
07_Delivery/toolchain/*.log
07_Delivery/toolchain/tmp/

# USB captures
*.pcap
*.pcapng
